  "description": "Horus Client — the open Minecraft client-launcher: mods, shop with earnable coins, cosmetics, minigames, social. Zero dependencies.",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "horus": "./server/index.js"
  },
  "scripts": {
